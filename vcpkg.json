{
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "3f7b5a12ef0a55e7b59339b2b69cac4b56d6dbf9",
      "repository": "https://github.com/microsoft/vcpkg"
    },
    "registries": [
      {
        "kind": "artifact",
        "location": "https://github.com/microsoft/vcpkg-ce-catalog/archive/refs/heads/main.zip",
        "name": "microsoft"
      }
    ]
  },
  "name": "blur",
  "dependencies": [
    "angle",
    {
      "name": "boost-asio",
      "version>=": "1.83.0"
    },
    {
      "name": "boost-process",
      "version>=": "1.83.0"
    },
    "cli11",
    {
      "name": "cppwinrt",
      "platform": "windows"
    },
    "cpr",
    "freetype",
    "gtest",
    "nlohmann-json",
    {
      "name": "sdbus-cpp",
      "platform": "linux"
    },
    "sdl3",
    {
      "name": "sdl3-image",
      "features": [
        "jpeg",
        "png"
      ]
    },
    "spdlog",
    "tl-expected"
  ],
  "default-features": [
    "angle-metal"
  ],
  "features": {
    "angle-metal": {
      "description": "Use ANGLE's Metal renderer on Apple platforms",
      "dependencies": [
        {
          "name": "angle",
          "features": [
            "metal"
          ],
          "platform": "osx"
        }
      ]
    }
  }
}
